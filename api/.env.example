NODE_ENV=development
PORT=3000
LOG_LEVEL=error

DATABASE_URL=postgres://saas:saas@localhost:5432/saas_platform
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173

SESSION_COOKIE_NAME=sid
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=14

RATE_LIMIT_MAX=40
RATE_LIMIT_TIME_WINDOW_MS=60000

JOBS_AUTO_MIGRATE=true
JOBS_CONCURRENCY=5
JOBS_POLL_INTERVAL_MS=1000
JOBS_MODULE_REFRESH_MS=30000

FILES_STORAGE_DRIVER=local
FILES_LOCAL_DIR=../storage/files

API_CLIENT_TOKEN_TTL_MINUTES=60
