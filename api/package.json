{
  "name": "@saas-platform/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "db:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "db:seed": "knex --knexfile knexfile.cjs seed:run",
    "test": "node --test",
    "dev:worker": "nodemon src/worker.js",
    "worker": "node src/worker.js",
    "jobs:migrate": "node scripts/migrate-jobs.js"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "argon2": "^0.31.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "pino-pretty": "^11.2.2",
    "zod": "^3.24.1",
    "graphile-worker": "^0.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
